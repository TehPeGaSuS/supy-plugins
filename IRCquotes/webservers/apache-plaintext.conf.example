# Example Apache vhost reverse-proxying the IRCquotes web interface
# (plain HTTP, no TLS). Requires mod_proxy and mod_proxy_http:
#
#   a2enmod proxy proxy_http
#   a2ensite ircquotes
#
# Adjust ServerName and the backend host:port to match your bot's
# supybot.servers.http.port (default 8080) and where it's reachable from
# this Apache instance.
#
# On the bot side, also set the public URL so any links it emits point
# here instead of http://<hostname>:8080/:
#
#   config supybot.servers.http.publicUrl http://quotes.example.com/

<VirtualHost *:80>
    ServerName quotes.example.com

    ProxyPreserveHost On

    # Only expose the IRCquotes endpoint (and its static assets under the
    # same prefix, e.g. /ircquotes/style.css), not the whole bot HTTP
    # server / plugin index.
    ProxyPass        /ircquotes/ http://127.0.0.1:8080/ircquotes/
    ProxyPassReverse /ircquotes/ http://127.0.0.1:8080/ircquotes/

    ErrorLog  ${APACHE_LOG_DIR}/ircquotes-error.log
    CustomLog ${APACHE_LOG_DIR}/ircquotes-access.log combined
</VirtualHost>
